APP_ENV=dev
AUTO_INIT_DB=true
LOG_LEVEL=INFO
# Worker SQS: text = alinhado e legivel; json = uma linha JSON por evento
WORKER_LOG_FORMAT=text

# SQLite local — metadados dos tickets (resumo, analise, etc.). Obrigatorio mesmo com Qdrant.
DATABASE_URL=sqlite:///./knowledge.db
# PostgreSQL (opcional):
#DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge_db

# Embeddings vetoriais no Qdrant (se QDRANT_URL estiver definida, vetores vao para la em vez do SQL)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=jira_ticket_embeddings

EMBEDDING_DIMENSION=1536
TOP_K_SIMILAR=5
MIN_SIMILARITY_SCORE=0.75
KNOWLEDGE_BASE_JQL=project = JDMSN1 AND status IN ("Aguardando retorno - Avalara", "Aguardando Retorno – Cliente", "Analise JDMS", Concluído, "Pendente Analise")
KNOWLEDGE_BASE_STATUSES=Aguardando retorno - Avalara|Aguardando Retorno - Cliente|Aguardando Retorno – Cliente|Analise JDMS|Concluido|Concluído|Pendente Analise

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SUP
JIRA_POST_COMMENTS=false
# ID do campo customizado "produto" no Jira (ex: customfield_10200).
# Deixe vazio para deteccao automatica por varredura de campos.
JIRA_PRODUCT_FIELD=
# ID do campo customizado "tema do chamado" no Jira (ex: customfield_10201).
JIRA_THEME_FIELD=
# Account ID do responsavel padrao e nome da transicao usada no fluxo de triagem.
JIRA_DEFAULT_ASSIGNEE_ID=
JIRA_TRIAGE_TRANSITION_NAME=Analise JDMS

# Inbox de retorno Avalara (IMAP)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=suporten1@jdmsconsulting.com.br
EMAIL_IMAP_PASSWORD=Jdms@2025@
EMAIL_IMAP_FOLDER=INBOX
# Lista separada por | (ex.: suporte@avalara.com|noreply@avalara.com)
EMAIL_ALLOWED_SENDERS=support@avalara.com
EMAIL_POLL_INTERVAL_SECONDS=30
EMAIL_MAX_MESSAGES_PER_POLL=20
EMAIL_MARK_AS_SEEN=true
EMAIL_TRIAGE_TRANSITION_NAME=Analise JDMS

# Fila SQS — o produtor (ex.: C#) publica JSON: {"chave_jira": "PROJ-123", ...}
# Worker na EC2: python -m worker.sqs_consumer
SQS_QUEUE_URL=
SQS_REGION=us-east-1
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=1
SQS_VISIBILITY_TIMEOUT=300
# Opcional: alinhar com apps .NET que usam chave embutida. Se vazio, boto3 usa IAM Role da EC2 / variaveis do Windows / ~/.aws
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# LLM: apenas Amazon Bedrock (credenciais AWS abaixo ou IAM Role na EC2)
LLM_PROVIDER=bedrock
BEDROCK_MODEL=amazon.nova-lite-v1:0
# Se vazio, usa SQS_REGION (ex.: us-east-1). Ative o modelo no console Bedrock na mesma regiao.
BEDROCK_REGION=
# OpenAI so para embeddings, se EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_MODEL=gpt-4o-mini
# Descricao do papel do N1 injetada no prompt. Deixe vazio para usar o padrao embutido.
N1_ROLE_DESCRIPTION=
